{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SubirYLeerFotosDeUsuarios",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::curso-app-imagenes/usuarios/*"
    },
    {
      "Sid": "HealthCheckDelBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::curso-app-imagenes"
    }
  ]
}
