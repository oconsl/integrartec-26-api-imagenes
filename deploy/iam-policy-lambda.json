{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LeerFotosOriginales",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::curso-app-imagenes/usuarios/*"
    },
    {
      "Sid": "EscribirMiniaturas",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::curso-app-miniaturas/*"
    },
    {
      "Sid": "LogsEnCloudWatch",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "*"
    }
  ]
}
