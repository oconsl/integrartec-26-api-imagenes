{
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/api-test-aws/out.log",
            "log_group_name": "/curso-app/api",
            "log_stream_name": "{instance_id}-out",
            "retention_in_days": 7
          },
          {
            "file_path": "/var/log/api-test-aws/error.log",
            "log_group_name": "/curso-app/api",
            "log_stream_name": "{instance_id}-error",
            "retention_in_days": 7
          }
        ]
      }
    }
  },
  "metrics": {
    "namespace": "CursoApp",
    "metrics_collected": {
      "mem": { "measurement": ["mem_used_percent"] },
      "disk": { "measurement": ["used_percent"], "resources": ["/"] }
    }
  }
}
