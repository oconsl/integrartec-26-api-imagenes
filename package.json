{
  "name": "api-test-aws",
  "version": "1.0.0",
  "description": "API Node.js de la Clase 44 (Introducción a AWS): registra usuarios en PostgreSQL (RDS) y sube fotos a S3",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "local:up": "docker compose up -d",
    "local:down": "docker compose down"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "express": "^5.2.1",
    "multer": "^2.0.2",
    "pg": "^8.16.3"
  }
}
