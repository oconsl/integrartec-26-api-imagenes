PORT=3000
AWS_REGION=sa-east-1

# --- Base de datos ---
# Local (docker compose): localhost
# AWS: endpoint de RDS, ej. curso-app-db.xxxxxxxx.sa-east-1.rds.amazonaws.com
DB_HOST=localhost
DB_PORT=5432
DB_NAME=curso_app
DB_USER=curso
DB_PASSWORD=curso1234
# En RDS: true
DB_SSL=false

# --- S3 ---
S3_BUCKET=curso-app-imagenes
# Segundos que dura la URL firmada de cada foto
S3_URL_EXPIRES_IN=300

# Solo local con LocalStack. En EC2 BORRÁ estas 3 líneas: las credenciales salen del IAM Role.
S3_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
